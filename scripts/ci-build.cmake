# The same presets used locally drive CI. This script only orchestrates checks.
cmake_minimum_required(VERSION 3.21)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT PRESET)
    message(FATAL_ERROR "PRESET is required")
endif()
if(NOT CONFIGURATION)
    set(CONFIGURATION Debug)
endif()
if(NOT GENERATOR)
    set(GENERATOR Ninja)
endif()
set(generator_args)
if(NOT GENERATOR STREQUAL "default")
    set(generator_args -G "${GENERATOR}")
endif()
set(build "${source}/build/${PRESET}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result WORKING_DIRECTORY "${source}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "CI command failed: ${ARGV}")
    endif()
endfunction()
function(source_overrides output)
    set(args)
    if(EXISTS "${build}/CMakeCache.txt")
        load_cache("${build}" READ_WITH_PREFIX populated_ FETCHCONTENT_SOURCE_DIR_STB
            FETCHCONTENT_SOURCE_DIR_GLFW FETCHCONTENT_SOURCE_DIR_VECTORGL_FREETYPE
            FETCHCONTENT_SOURCE_DIR_VECTORGL_LIBTESS2)
    endif()
    foreach(dependency IN ITEMS stb glfw vectorgl_freetype vectorgl_libtess2)
        string(TOUPPER "${dependency}" key)
        if(populated_FETCHCONTENT_SOURCE_DIR_${key})
            list(APPEND args "-DFETCHCONTENT_SOURCE_DIR_${key}=${populated_FETCHCONTENT_SOURCE_DIR_${key}}")
        elseif(EXISTS "${build}/_deps/${dependency}-src")
            list(APPEND args "-DFETCHCONTENT_SOURCE_DIR_${key}=${build}/_deps/${dependency}-src")
        endif()
    endforeach()
    set(${output} "${args}" PARENT_SCOPE)
endfunction()
source_overrides(dependencies)
set(toolchain)
if(CC)
    list(APPEND toolchain "-DCMAKE_C_COMPILER=${CC}")
endif()
if(CXX)
    list(APPEND toolchain "-DCMAKE_CXX_COMPILER=${CXX}")
endif()
find_program(ccache NAMES ccache)
if(ccache)
    list(APPEND toolchain "-DCMAKE_C_COMPILER_LAUNCHER=${ccache}" "-DCMAKE_CXX_COMPILER_LAUNCHER=${ccache}")
endif()
checked(${CMAKE_COMMAND} --preset "${PRESET}" -B "${build}" ${generator_args}
    "-DCMAKE_BUILD_TYPE=${CONFIGURATION}" -DGLFW_INSTALL=ON ${dependencies} ${toolchain})
checked(${CMAKE_COMMAND} --build "${build}" --config "${CONFIGURATION}" --parallel)
load_cache("${build}" READ_WITH_PREFIX configured_ CMAKE_GENERATOR)
set(GENERATOR "${configured_CMAKE_GENERATOR}")
if(PRESET STREQUAL "quality")
    return()
endif()
if(NOT PRESET MATCHES "^library")
    checked(${CMAKE_CTEST_COMMAND} --test-dir "${build}" -C "${CONFIGURATION}"
        --output-on-failure --no-tests=error --output-junit results.xml)
endif()
set(sdk "${build}/sdk")
checked(${CMAKE_COMMAND} --install "${build}" --config "${CONFIGURATION}" --prefix "${sdk}")
load_cache("${build}" READ_WITH_PREFIX enabled_ VECTORGL_BUILD_UI VECTORGL_BUILD_GLFW_ADAPTER
    VECTORGL_BUILD_DIALOGS VECTORGL_BUILD_GPU_TESTS)
set(no_ui ON)
if(enabled_VECTORGL_BUILD_UI)
    set(no_ui OFF)
endif()
checked(${CMAKE_COMMAND} "-DSDK=${sdk}" "-DWORK_DIR=${build}/consumers" "-DGENERATOR=${GENERATOR}"
    "-DCONFIGURATION=${CONFIGURATION}" "-DEXPECT_NO_UI=${no_ui}"
    "-DHAS_UI=${enabled_VECTORGL_BUILD_UI}" "-DHAS_DIALOGS=${enabled_VECTORGL_BUILD_DIALOGS}"
    "-DHAS_HOST=${enabled_VECTORGL_BUILD_GLFW_ADAPTER}" "-DGPU_TESTS=${enabled_VECTORGL_BUILD_GPU_TESTS}"
    -P "${CMAKE_CURRENT_LIST_DIR}/verify-package.cmake")
if(VERIFY_EMBEDDED)
    source_overrides(dependencies)
    checked(${CMAKE_COMMAND} -S "${source}/tests/cmake" -B "${build}/embedded" -G "${GENERATOR}"
        "-DCMAKE_BUILD_TYPE=${CONFIGURATION}" -DVECTORGL_FETCH_DEPENDENCIES=OFF ${dependencies} ${toolchain})
    checked(${CMAKE_COMMAND} --build "${build}/embedded" --config "${CONFIGURATION}" --parallel)
    checked(${CMAKE_CTEST_COMMAND} --test-dir "${build}/embedded" -C "${CONFIGURATION}" --output-on-failure --no-tests=error)
endif()
