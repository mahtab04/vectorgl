cmake_minimum_required(VERSION 3.21)
get_filename_component(VECTORGL_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(required IN ITEMS SDK WORK_DIR GENERATOR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
if(NOT CONFIGURATION)
    set(CONFIGURATION Release)
endif()
if(FULL_SDK)
    set(HAS_UI ON)
    set(HAS_DIALOGS ON)
    set(HAS_HOST ON)
endif()
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Package verification command failed: ${ARGV}")
    endif()
endfunction()
function(consumer name source)
    checked(${CMAKE_COMMAND} -S "${VECTORGL_SOURCE_DIR}/${source}" -B "${WORK_DIR}/${name}"
        -G "${GENERATOR}" "-DCMAKE_PREFIX_PATH=${SDK}" "-DCMAKE_BUILD_TYPE=${CONFIGURATION}" ${ARGN})
    checked(${CMAKE_COMMAND} --build "${WORK_DIR}/${name}" --config "${CONFIGURATION}" --parallel)
    checked(${CMAKE_CTEST_COMMAND} --test-dir "${WORK_DIR}/${name}" -C "${CONFIGURATION}"
        --output-on-failure --no-tests=error --output-junit results.xml)
endfunction()
consumer(core tests/package_consumer "-DVECTORGL_EXPECT_NO_UI=${EXPECT_NO_UI}")
if(FULL_SDK OR HAS_UI)
    consumer(ui tests/ui_package_consumer)
endif()
if(FULL_SDK OR HAS_DIALOGS)
    consumer(dialogs tests/ui_package_consumer -DVECTORGL_TEST_DIALOGS=ON)
endif()
if(FULL_SDK OR HAS_HOST)
    consumer(host tests/ui_package_consumer "-DVECTORGL_TEST_DIALOGS=${HAS_DIALOGS}" -DVECTORGL_TEST_GLFW=ON
        -DVECTORGL_TEST_WORKSPACE=ON "-DVECTORGL_TEST_WORKSPACE_GPU=${GPU_TESTS}")
endif()
