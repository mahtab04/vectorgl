cmake_minimum_required(VERSION 3.21)
foreach(required IN ITEMS BUILD_DIR OUTPUT_DIR GENERATOR PLATFORM)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
if(NOT CONFIGURATION)
    set(CONFIGURATION Release)
endif()
if(NOT FLAVOR MATCHES "^(core|full)$")
    message(FATAL_ERROR "FLAVOR must be core or full")
endif()
get_filename_component(VECTORGL_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
# CMake project() does not cache the version; read the generated package file.
file(STRINGS "${BUILD_DIR}/vectorglConfigVersion.cmake" version_line REGEX "^set\\(PACKAGE_VERSION ")
string(REGEX REPLACE "^set\\(PACKAGE_VERSION \"([^\"]+)\"\\).*" "\\1" version "${version_line}")
if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "Cannot determine SDK version")
endif()
if(EXPECTED_TAG AND NOT EXPECTED_TAG STREQUAL "v${version}")
    message(FATAL_ERROR "Tag ${EXPECTED_TAG} does not match project version v${version}")
endif()
string(RANDOM LENGTH 10 nonce)
set(package_dir "${BUILD_DIR}/package-${nonce}")
set(stage "${package_dir}/staging")
set(relocated "${package_dir}/relocated")
file(MAKE_DIRECTORY "${OUTPUT_DIR}" "${relocated}")
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Packaging command failed: ${ARGV}")
    endif()
endfunction()
checked(${CMAKE_COMMAND} --install "${BUILD_DIR}" --config "${CONFIGURATION}" --prefix "${stage}")
set(extension tar.gz)
set(archive_args czf)
if(WIN32)
    set(extension zip)
    set(archive_args cf)
endif()
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
set(archive "${OUTPUT_DIR}/vectorgl-${version}-${PLATFORM}-${FLAVOR}.${extension}")
if(WIN32)
    execute_process(COMMAND ${CMAKE_COMMAND} -E tar ${archive_args} "${archive}" --format=zip . WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result)
else()
    execute_process(COMMAND ${CMAKE_COMMAND} -E tar ${archive_args} "${archive}" . WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result)
endif()
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot create SDK archive")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E tar xf "${archive}" WORKING_DIRECTORY "${relocated}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot extract SDK archive")
endif()
# Make the old prefix unavailable: consumers must resolve the relocated SDK.
file(RENAME "${stage}" "${package_dir}/original-prefix-unused")
set(full OFF)
set(no_ui ON)
if(FLAVOR STREQUAL "full")
    set(full ON)
    set(no_ui OFF)
endif()
checked(${CMAKE_COMMAND} "-DSDK=${relocated}" "-DWORK_DIR=${package_dir}/consumers"
    "-DGENERATOR=${GENERATOR}" "-DCONFIGURATION=${CONFIGURATION}"
    "-DFULL_SDK=${full}" "-DEXPECT_NO_UI=${no_ui}" "-DGPU_TESTS=${GPU_TESTS}"
    -P "${CMAKE_CURRENT_LIST_DIR}/verify-package.cmake")
file(SHA256 "${archive}" checksum)
file(WRITE "${archive}.sha256" "${checksum}  vectorgl-${version}-${PLATFORM}-${FLAVOR}.${extension}\n")
message(STATUS "Verified relocated SDK: ${archive}")
