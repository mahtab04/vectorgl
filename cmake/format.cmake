# Formatting is independent of enabled build targets; third-party code is excluded.
if(NOT DEFINED VECTORGL_SOURCE_DIR OR NOT DEFINED VECTORGL_FORMATTER)
    message(FATAL_ERROR "Source directory and formatter are required")
endif()
set(sources)
foreach(directory IN ITEMS src include tests example apps)
    foreach(extension IN ITEMS c cc cpp cxx h hh hpp hxx)
        file(GLOB_RECURSE files "${VECTORGL_SOURCE_DIR}/${directory}/*.${extension}")
        list(APPEND sources ${files})
    endforeach()
endforeach()
set(arguments --dry-run --Werror)
if(VECTORGL_FORMAT_WRITE)
    set(arguments -i)
endif()
set(failed FALSE)
foreach(source IN LISTS sources)
    execute_process(COMMAND "${VECTORGL_FORMATTER}" ${arguments} -style=file "${source}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        set(failed TRUE)
    endif()
endforeach()
if(failed)
    message(FATAL_ERROR "Formatting failed; run vectorgl-format with clang-format 18")
endif()
