@PACKAGE_INIT@

if(@VECTORGL_ENABLE_HINTED_TEXT@)
    include(CMakeFindDependencyMacro)
    find_dependency(freetype CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/vectorglTargets.cmake")

set(vectorgl_ui_FOUND FALSE)
set(vectorgl_glfw_FOUND FALSE)
set(vectorgl_dialogs_FOUND FALSE)
foreach(component IN LISTS vectorgl_FIND_COMPONENTS)
    if((component STREQUAL "ui" OR component STREQUAL "glfw" OR component STREQUAL "dialogs") AND @VECTORGL_BUILD_UI@)
        include("${CMAKE_CURRENT_LIST_DIR}/vectorglUiTargets.cmake")
        set(vectorgl_ui_FOUND TRUE)
    endif()
    if(component STREQUAL "dialogs" AND @VECTORGL_BUILD_DIALOGS@)
        include("${CMAKE_CURRENT_LIST_DIR}/vectorglDialogsTargets.cmake")
        set(vectorgl_dialogs_FOUND TRUE)
    endif()
    if(component STREQUAL "glfw" AND @VECTORGL_BUILD_GLFW_ADAPTER@)
        include(CMakeFindDependencyMacro)
        find_dependency(glfw3 3.3 CONFIG)
        include("${CMAKE_CURRENT_LIST_DIR}/vectorglGlfwTargets.cmake")
        set(vectorgl_glfw_FOUND TRUE)
    endif()
endforeach()

check_required_components(vectorgl)
