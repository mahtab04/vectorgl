include_guard(GLOBAL)

option(VECTORGL_BUILD_EXAMPLES "Build the graphical examples" OFF)
option(VECTORGL_BUILD_APPS "Build Flow Studio" OFF)
option(VECTORGL_BUILD_TESTS "Build engine and enabled UI tests" ${PROJECT_IS_TOP_LEVEL})
option(VECTORGL_BUILD_APP_TESTS "Build Flow Studio document/workspace tests" OFF)
option(VECTORGL_BUILD_GPU_TESTS "Build display-dependent GPU/smoke tests" OFF)
option(VECTORGL_ENABLE_HINTED_TEXT "Enable FreeType small-text rendering" ON)
option(VECTORGL_BUILD_UI "Build the application UI module" OFF)
option(VECTORGL_BUILD_UI_EXAMPLES "Build UI examples (graphical examples require the GLFW adapter)" ${VECTORGL_BUILD_EXAMPLES})
option(VECTORGL_BUILD_GLFW_ADAPTER "Build the UI GLFW adapter" OFF)
option(VECTORGL_BUILD_DIALOGS "Build optional native file dialogs" OFF)
option(VECTORGL_FETCH_DEPENDENCIES "Allow downloading missing dependencies" ON)
set(VECTORGL_FREETYPE_PROVIDER "BUNDLED" CACHE STRING "FreeType provider: BUNDLED, SYSTEM, AUTO")
set_property(CACHE VECTORGL_FREETYPE_PROVIDER PROPERTY STRINGS BUNDLED SYSTEM AUTO)
if(NOT VECTORGL_FREETYPE_PROVIDER MATCHES "^(BUNDLED|SYSTEM|AUTO)$")
    message(FATAL_ERROR "VECTORGL_FREETYPE_PROVIDER must be BUNDLED, SYSTEM or AUTO")
endif()

# Compatibility inputs only: do not create generic cache entries in parent projects.
# Explicit canonical settings take precedence; old build scripts keep working.
function(vectorgl_compatible_option name legacy description default)
    if(PROJECT_IS_TOP_LEVEL AND NOT DEFINED ${name} AND DEFINED ${legacy})
        set(${name} "${${legacy}}" CACHE BOOL "${description}")
        message(STATUS "${legacy} is deprecated; use ${name}")
    endif()
    option(${name} "${description}" ${default})
endfunction()
vectorgl_compatible_option(VECTORGL_ENABLE_CLANG_TIDY ENABLE_CLANG_TIDY "Run clang-tidy" OFF)
vectorgl_compatible_option(VECTORGL_ENABLE_FORMAT_CHECK ENABLE_FORMAT_CHECK "Check first-party formatting" OFF)
vectorgl_compatible_option(VECTORGL_ENABLE_COMPILER_WARNINGS ENABLE_COMPILER_WARNINGS "Enable private compiler warnings" ON)
vectorgl_compatible_option(VECTORGL_ENABLE_SANITIZERS ENABLE_SANITIZERS "Enable ASan/UBSan" OFF)

foreach(feature IN ITEMS VECTORGL_BUILD_DIALOGS VECTORGL_BUILD_GLFW_ADAPTER)
    if(${feature} AND NOT VECTORGL_BUILD_UI)
        message(FATAL_ERROR "${feature} requires VECTORGL_BUILD_UI=ON")
    endif()
endforeach()
if(VECTORGL_BUILD_GPU_TESTS AND NOT (VECTORGL_BUILD_TESTS OR VECTORGL_BUILD_APP_TESTS))
    message(FATAL_ERROR "GPU tests require VECTORGL_BUILD_TESTS or VECTORGL_BUILD_APP_TESTS")
endif()
