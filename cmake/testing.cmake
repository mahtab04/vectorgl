include_guard(GLOBAL)
if(VECTORGL_BUILD_GPU_TESTS AND UNIX AND NOT APPLE)
    find_program(XVFB_RUN_EXECUTABLE NAMES xvfb-run)
endif()

function(vectorgl_label_tests directory)
    get_property(tests DIRECTORY "${directory}" PROPERTY TESTS)
    foreach(test IN LISTS tests)
        set(labels unit)
        if(test MATCHES "^flow_")
            list(APPEND labels app)
        elseif(test MATCHES "^vectorgl_ui_")
            list(APPEND labels ui)
        else()
            list(APPEND labels engine)
        endif()
        if(test MATCHES "smoke|gpu_tests|paint_tests")
            set(labels gpu smoke)
            if(test MATCHES "^vectorgl_ui_")
                list(APPEND labels ui)
            endif()
        endif()
        if(test STREQUAL "vectorgl_ui_routing_smoke")
            set(labels unit ui smoke)
        endif()
        if(test MATCHES "^flow_" AND NOT "app" IN_LIST labels)
            list(APPEND labels app)
        endif()
        set_tests_properties(${test} PROPERTIES LABELS "${labels}")
    endforeach()
endfunction()
