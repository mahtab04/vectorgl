{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VECTORGL_BUILD_EXAMPLES": "ON",
        "VECTORGL_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "description": "Configure using the locally available default generator (Visual Studio 2022 or 2026).",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows-debug",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "description": "Configure using the locally available default generator (Visual Studio 2022 or 2026).",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows-release",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "Configure a Debug build on Linux with the Ninja generator.",
      "inherits": [
        "base"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "Configure a Release build on Linux with the Ninja generator.",
      "inherits": [
        "base"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-release"
      }
    },
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows MinGW Debug",
      "description": "Use MinGW-w64 gcc/g++ and mingw32-make from PATH.",
      "inherits": [
        "base"
      ],
      "generator": "MinGW Makefiles",
      "condition": {
        "lhs": "${hostSystemName}",
        "type": "equals",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows-mingw-debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MinGW Release",
      "description": "Use MinGW-w64 gcc/g++ and mingw32-make from PATH.",
      "inherits": [
        "base"
      ],
      "generator": "MinGW Makefiles",
      "condition": {
        "lhs": "${hostSystemName}",
        "type": "equals",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows-mingw-release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "windows-mingw-debug",
      "configurePreset": "windows-mingw-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "output": {
        "outputOnFailure": true
      },
      "configuration": "Debug",
      "name": "windows-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "configurePreset": "windows-debug"
    },
    {
      "output": {
        "outputOnFailure": true
      },
      "configuration": "Release",
      "name": "windows-release",
      "execution": {
        "noTestsAction": "error"
      },
      "configurePreset": "windows-release"
    },
    {
      "output": {
        "outputOnFailure": true
      },
      "name": "linux-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "configurePreset": "linux-debug"
    },
    {
      "output": {
        "outputOnFailure": true
      },
      "name": "linux-release",
      "execution": {
        "noTestsAction": "error"
      },
      "configurePreset": "linux-release"
    },
    {
      "output": {
        "outputOnFailure": true
      },
      "configuration": "Debug",
      "name": "windows-mingw-debug",
      "execution": {
        "noTestsAction": "error"
      },
      "configurePreset": "windows-mingw-debug"
    },
    {
      "output": {
        "outputOnFailure": true
      },
      "configuration": "Release",
      "name": "windows-mingw-release",
      "execution": {
        "noTestsAction": "error"
      },
      "configurePreset": "windows-mingw-release"
    }
  ]
}
