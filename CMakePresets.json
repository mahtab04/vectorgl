{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "profile-library",
      "hidden": true,
      "cacheVariables": {
        "VECTORGL_BUILD_EXAMPLES": "OFF",
        "VECTORGL_BUILD_APPS": "OFF",
        "VECTORGL_BUILD_TESTS": "OFF",
        "VECTORGL_BUILD_APP_TESTS": "OFF",
        "VECTORGL_BUILD_GPU_TESTS": "OFF",
        "VECTORGL_BUILD_UI": "OFF",
        "VECTORGL_BUILD_UI_EXAMPLES": "OFF",
        "VECTORGL_BUILD_GLFW_ADAPTER": "OFF",
        "VECTORGL_BUILD_DIALOGS": "OFF",
        "VECTORGL_ENABLE_CLANG_TIDY": "OFF",
        "VECTORGL_ENABLE_FORMAT_CHECK": "OFF",
        "VECTORGL_ENABLE_SANITIZERS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "profile-developer",
      "hidden": true,
      "inherits": "profile-library",
      "cacheVariables": {
        "VECTORGL_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "profile-ui",
      "hidden": true,
      "inherits": "profile-developer",
      "cacheVariables": {
        "VECTORGL_BUILD_UI": "ON"
      }
    },
    {
      "name": "profile-workspace",
      "hidden": true,
      "inherits": "profile-ui",
      "cacheVariables": {
        "VECTORGL_BUILD_GLFW_ADAPTER": "ON",
        "VECTORGL_BUILD_DIALOGS": "ON",
        "VECTORGL_BUILD_UI_EXAMPLES": "ON"
      }
    },
    {
      "name": "profile-full",
      "hidden": true,
      "inherits": "profile-workspace",
      "cacheVariables": {
        "VECTORGL_BUILD_EXAMPLES": "ON",
        "VECTORGL_BUILD_APPS": "ON",
        "VECTORGL_BUILD_APP_TESTS": "ON",
        "VECTORGL_BUILD_GPU_TESTS": "ON"
      }
    },
    {
      "name": "profile-headless",
      "hidden": true,
      "inherits": "profile-ui",
      "cacheVariables": {
        "VECTORGL_BUILD_DIALOGS": "ON"
      }
    },
    {
      "name": "library",
      "displayName": "Core SDK without tests or window dependencies",
      "inherits": "profile-library",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    },
    {
      "name": "developer",
      "displayName": "Core library and CPU tests",
      "inherits": "profile-developer",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    },
    {
      "name": "ui",
      "displayName": "UI library and headless tests",
      "inherits": "profile-ui",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    },
    {
      "name": "workspace",
      "displayName": "UI workspace examples and native dialogs",
      "inherits": "profile-workspace",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    },
    {
      "name": "full",
      "displayName": "All modules, apps, examples and GPU tests",
      "inherits": "profile-full",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    },
    {
      "name": "ci-headless",
      "displayName": "Headless UI and dialog tests",
      "inherits": "profile-headless",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    },
    {
      "name": "library-release",
      "inherits": "library",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "workspace-release",
      "inherits": "workspace",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "full-release",
      "inherits": "full",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "ci-headless",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VECTORGL_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "quality",
      "inherits": "full",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "VECTORGL_ENABLE_CLANG_TIDY": "ON",
        "VECTORGL_ENABLE_FORMAT_CHECK": "ON",
        "VECTORGL_BUILD_GPU_TESTS": "OFF"
      }
    },
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VECTORGL_BUILD_EXAMPLES": "ON",
        "VECTORGL_BUILD_TESTS": "ON",
        "VECTORGL_BUILD_APPS": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      },
      "inherits": "profile-developer"
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "description": "Configure using the locally available default generator (Visual Studio 2022 or 2026).",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows-debug",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "description": "Configure using the locally available default generator (Visual Studio 2022 or 2026).",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows-release",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "Configure a Debug build on Linux with the Ninja generator.",
      "inherits": [
        "base"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "Configure a Release build on Linux with the Ninja generator.",
      "inherits": [
        "base"
      ],
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-release"
      }
    },
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows MinGW Debug",
      "description": "Use MinGW-w64 gcc/g++ and mingw32-make from PATH.",
      "inherits": [
        "base"
      ],
      "generator": "MinGW Makefiles",
      "condition": {
        "lhs": "${hostSystemName}",
        "type": "equals",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows-mingw-debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MinGW Release",
      "description": "Use MinGW-w64 gcc/g++ and mingw32-make from PATH.",
      "inherits": [
        "base"
      ],
      "generator": "MinGW Makefiles",
      "condition": {
        "lhs": "${hostSystemName}",
        "type": "equals",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows-mingw-release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "ci-host",
      "inherits": "full",
      "cacheVariables": {
        "VECTORGL_BUILD_GPU_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
