if(NOT VECTORGL_BUILD_GPU_TESTS)
    return()
endif()

function(vectorgl_add_smoke name target timeout)
    if(NOT TARGET ${target})
        return()
    endif()
    set(runner)
    if(XVFB_RUN_EXECUTABLE)
        set(runner ${XVFB_RUN_EXECUTABLE} -a)
    endif()
    add_test(NAME ${name} COMMAND ${runner} $<TARGET_FILE:${target}> ${ARGN})
    set_tests_properties(${name} PROPERTIES TIMEOUT ${timeout})
endfunction()

set(font_args --font ${CMAKE_CURRENT_SOURCE_DIR}/fixtures/box.ttf)
foreach(example IN ITEMS palette dashes strokes fill_rules large_scene scene_content text_layout text_raster)
    set(name vectorgl_${example}_demo_smoke)
    if(example STREQUAL "palette")
        set(name vectorgl_palette_smoke)
    endif()
    vectorgl_add_smoke(${name} vectorgl_${example} 30 --smoke-test ${font_args})
endforeach()
