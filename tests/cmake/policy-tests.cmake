cmake_minimum_required(VERSION 3.21)
string(RANDOM LENGTH 8 nonce)
function(check name success expected)
    set(directory "${WORK_DIR}/${nonce}-${name}")
    set(dependencies)
    if(NOT name STREQUAL "missing")
        list(APPEND dependencies "-DFETCHCONTENT_SOURCE_DIR_STB=${STB_DIR}"
            "-DFETCHCONTENT_SOURCE_DIR_VECTORGL_LIBTESS2=${TESS_DIR}")
    endif()
    execute_process(COMMAND ${CMAKE_COMMAND} -S "${SOURCE_DIR}" -B "${directory}" -G "${GENERATOR}"
        "-DCMAKE_C_COMPILER=${C_COMPILER}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
        -DVECTORGL_ENABLE_HINTED_TEXT=OFF -DVECTORGL_BUILD_TESTS=OFF
        -DVECTORGL_FETCH_DEPENDENCIES=OFF ${dependencies} ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(MAKE_DIRECTORY "${directory}")
    file(WRITE "${directory}/policy.log" "${output}\n${error}")
    if(success AND NOT result EQUAL 0)
        message(FATAL_ERROR "${name} should configure: ${output}${error}")
    elseif(NOT success AND result EQUAL 0)
        message(FATAL_ERROR "${name} should fail")
    endif()
    if(expected AND NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "${name}: expected diagnostic '${expected}': ${output}${error}")
    endif()
    if(name STREQUAL "legacy")
        file(READ "${directory}/CMakeCache.txt" cache)
        foreach(entry IN ITEMS VECTORGL_ENABLE_COMPILER_WARNINGS:BOOL=OFF VECTORGL_ENABLE_FORMAT_CHECK:BOOL=OFF)
            if(NOT cache MATCHES "${entry}")
                message(FATAL_ERROR "Legacy/canonical precedence failed: ${entry}")
            endif()
        endforeach()
    endif()
    message(STATUS "CMake policy ${name}: passed")
endfunction()
check(missing FALSE "Downloads disabled")
check(host FALSE "requires VECTORGL_BUILD_UI=ON" -DVECTORGL_BUILD_GLFW_ADAPTER=ON)
check(gpu FALSE "GPU tests require" -DVECTORGL_BUILD_GPU_TESTS=ON)
check(provider FALSE "must be BUNDLED" -DVECTORGL_FREETYPE_PROVIDER=invalid)
check(format-version FALSE "requires clang-format 18" -DVECTORGL_ENABLE_FORMAT_CHECK=ON "-DCLANG_FORMAT_EXE=${CMAKE_COMMAND}")
check(legacy TRUE "" -DENABLE_COMPILER_WARNINGS=OFF -DENABLE_FORMAT_CHECK=ON -DVECTORGL_ENABLE_FORMAT_CHECK=OFF)
