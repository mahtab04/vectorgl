cmake_minimum_required(VERSION 3.21)
# Check the public defaults without requiring a window-system SDK in headless CI.
include("${SOURCE_DIR}/cmake/options.cmake")
foreach(option IN ITEMS BUILD_UI BUILD_GLFW_ADAPTER BUILD_DIALOGS)
    if(NOT VECTORGL_${option})
        message(FATAL_ERROR "VECTORGL_${option} must default ON")
    endif()
endforeach()
foreach(option IN ITEMS BUILD_TESTS BUILD_APP_TESTS BUILD_APPS BUILD_EXAMPLES
        BUILD_UI_EXAMPLES BUILD_GPU_TESTS ENABLE_CLANG_TIDY ENABLE_FORMAT_CHECK ENABLE_SANITIZERS)
    if(VECTORGL_${option})
        message(FATAL_ERROR "VECTORGL_${option} must default OFF")
    endif()
endforeach()
message(STATUS "Default library modules and opt-in extras: passed")
file(READ "${SOURCE_DIR}/CMakePresets.json" presets)
string(JSON count LENGTH "${presets}" configurePresets)
math(EXPR last "${count} - 1")
set(found_library FALSE)
foreach(index RANGE 0 ${last})
    string(JSON name GET "${presets}" configurePresets ${index} name)
    if(name STREQUAL "profile-library")
        string(JSON install_glfw GET "${presets}" configurePresets ${index} cacheVariables GLFW_INSTALL)
        if(NOT install_glfw STREQUAL "ON")
            message(FATAL_ERROR "Library presets must enable GLFW_INSTALL to migrate old OFF caches")
        endif()
        set(found_library TRUE)
    endif()
endforeach()
if(NOT found_library)
    message(FATAL_ERROR "Library preset missing")
endif()
